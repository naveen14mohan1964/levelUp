DB_SERVER=localhost
DB_NAME=DSATracker
DB_DRIVER=ODBC Driver 17 for SQL Server
PORT=4001
# Get a key at https://aistudio.google.com/apikey (never commit the real one)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Free tier: ~20 requests per model per day, so the app falls back through these when one is used up
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
# Telegram meal bot: create one with @BotFather (/newbot) and paste its token here (keep it secret)
TELEGRAM_BOT_TOKEN=
