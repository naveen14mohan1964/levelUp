# Copy to tracker/.env for Docker (this file is only for docker compose; the app's own keys stay in server/.env).
# SQL Server "sa" password: 8+ characters with upper case, lower case, a number and a symbol.
DB_PASSWORD=change-Me-123!
# Phone access from anywhere (optional): uncomment COMPOSE_PROFILES and add a Tailscale auth key
# (tailscale.com → Settings → Keys → Generate auth key). Needs a network that allows Tailscale (e.g. home Wi-Fi).
# COMPOSE_PROFILES=phone
TS_AUTHKEY=
# Host port on this laptop (default 4000)
APP_PORT=4000
# Time zone for day boundaries (default Asia/Kolkata)
# TZ=Asia/Kolkata
